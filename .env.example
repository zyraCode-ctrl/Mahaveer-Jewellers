# Copy this file to .env and fill in the values. Never commit .env.

# Long-lived Instagram access token for @mahaveer__jewellers (professional account).
# Instagram Login tokens: needs the instagram_business_basic permission.
# Facebook Login tokens: needs instagram_basic + pages_show_list, and INSTAGRAM_USER_ID below.
INSTAGRAM_ACCESS_TOKEN=

# Only for Facebook Login tokens: the Instagram professional account ID.
INSTAGRAM_USER_ID=

INSTAGRAM_GRAPH_VERSION=v21.0
# How long the server reuses the Instagram response, in seconds.
INSTAGRAM_CACHE_SECONDS=900
PORT=5510
